{
  "name": "saotechmarket",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @saotech/shared build && pnpm --filter @saotech/api build && pnpm --filter @saotech/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
