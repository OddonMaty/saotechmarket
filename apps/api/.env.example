# Node Environment (development | production | test)
NODE_ENV=development

# Server Host & Port
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origin (Next.js web application URL)
WEB_ORIGIN=http://localhost:3000

# Database Connection (MySQL)
DATABASE_URL=mysql://saotech_user:saotech_password@localhost:3306/saotech_market

# Internal API Secret Key
API_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

